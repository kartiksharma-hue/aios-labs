# Contact form delivery.
#
# Until CONTACT_WEBHOOK_URL is set, /api/contact validates submissions and then
# responds honestly that delivery is not configured. The form tells the visitor
# so rather than reporting a success that did not happen.
#
# Set this to any endpoint that accepts a JSON POST — a CRM intake URL, an
# automation webhook, or your own mail service. The request body is:
#   { source, receivedAt, name, email, company, website, improve, spend,
#     service, context }
CONTACT_WEBHOOK_URL=

# Optional. Sent as `Authorization: Bearer <token>` when present.
CONTACT_WEBHOOK_TOKEN=
